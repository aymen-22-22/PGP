# Copy to .env.test. Used only by `npm test`, which runs against a real
# PostgreSQL database — transactional business rules cannot be verified
# against a mock. Point DATABASE_URL at a scratch database: the suite
# truncates every table between tests.
NODE_ENV=test
DATABASE_URL=postgresql://phoneerp:devpass@localhost:5433/phoneerp_test?schema=public
JWT_SECRET=test-only-secret-not-used-anywhere-else-0123456789
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
AUTO_VALIDATE_RECEIPT=true
ALLOW_PARTIAL_RECEIPT=true
# The suite logs in on every test; the limiter itself is covered by its own test.
THROTTLE_LOGIN_LIMIT=100000
THROTTLE_LIMIT=100000

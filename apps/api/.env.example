# ---------------------------------------------------------------------------
# Phone ERP — API configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=production

# Port your host assigns to the Node application.
PORT=3000

# Interface to bind. Leave as 0.0.0.0 when the host reaches the app directly.
# Set 127.0.0.1 when something in front terminates TLS and proxies to it
# (nginx, Tailscale Serve) so the plain-HTTP port is not reachable at all.
HOST=0.0.0.0

# Serve the built web app from this API, giving one origin: no CORS, and the
# session cookie is same-site by construction. Point it at apps/web/dist.
# Leave unset if something else serves the frontend.
# SERVE_WEB_ROOT=../web/dist

# Where product photos are written, and served from at /uploads.
# Keep this outside the web build, which is wiped on every deploy.
UPLOAD_DIR=./uploads
# Ceiling on one stored picture. The browser shrinks photos to roughly 800px
# before sending, so anything near this limit is a client that did not.
UPLOAD_MAX_BYTES=2000000

# --- Email notifications -----------------------------------------------------
#
# Goods-in, short deliveries, despatch, arrival and receipt validation are
# emailed to administrators and to the warehouse concerned.
#
# With no SMTP_HOST set, nothing is sent and nothing is queued — the system
# behaves exactly as it did before. Set a host to turn it on.
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                  # 465 for implicit TLS, 587 for STARTTLS
# SMTP_USER=erp@example.com
# SMTP_PASSWORD=
# MAIL_FROM=Phone ERP <erp@example.com>

# How often the queue is retried, and how many times before giving up.
# A message that cannot be sent is kept with the reason rather than dropped.
MAIL_SWEEP_MS=60000
MAIL_MAX_ATTEMPTS=6

# Path prefix for every endpoint. Change only if your host mounts the app
# under a sub-path.
API_PREFIX=api/v1

# --- Database --------------------------------------------------------------
# PostgreSQL connection string. Use the private/internal host your provider
# gives you, never a publicly reachable one.
# Add &connection_limit=5 on shared hosting with a low connection cap.
#
# On Neon, use the direct string — the host WITHOUT the -pooler suffix:
#   postgresql://user:pass@ep-….c-2.eu-central-1.aws.neon.tech/db?sslmode=require&connection_limit=5
# The API is one long-lived process with its own pool, so it gains little from
# PgBouncer and inherits its restrictions. Using the pooled host with Prisma
# additionally needs &pgbouncer=true. See docs/deployment.md.
DATABASE_URL=postgresql://user:password@localhost:5432/phone_erp?schema=public

# --- Authentication --------------------------------------------------------
# At least 32 characters. Generate with:  openssl rand -base64 48
JWT_SECRET=
# How long a session lasts: 30m, 12h, 7d…
JWT_EXPIRES_IN=12h

# Cookie behaviour. COOKIE_SECURE must stay true wherever you serve HTTPS.
AUTH_COOKIE_NAME=perp_token
CSRF_COOKIE_NAME=perp_csrf
COOKIE_SECURE=true
# "lax" is right when the API and the web app share a site.
# Use "none" (with COOKIE_SECURE=true) only if they are on unrelated domains.
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com

# --- Web client ------------------------------------------------------------
FRONTEND_URL=https://erp.example.com
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGIN=https://erp.example.com

# --- Receiving rules (spec §15) --------------------------------------------
# AUTO_VALIDATE_RECEIPT=true  → scanned phones go straight into sellable stock.
# REQUIRE_RECEIPT_VALIDATION=true → they wait in status RECEIVED until an
# administrator validates the receipt. The REQUIRE_ flag wins if both are set.
AUTO_VALIDATE_RECEIPT=true
REQUIRE_RECEIPT_VALIDATION=false

# May a receipt be closed with fewer phones than expected?
ALLOW_PARTIAL_RECEIPT=true

# --- IMEI ------------------------------------------------------------------
# Verify the Luhn check digit as well as the length. Off by default: real
# stock regularly carries IMEIs that were mistyped upstream, and refusing to
# receive a physical phone you are holding helps nobody.
IMEI_ENFORCE_CHECKSUM=false

# --- Operations ------------------------------------------------------------
# Serve Swagger at /api/docs. Leave false in production.
SWAGGER_ENABLED=false

# Trust X-Forwarded-For. Required behind a reverse proxy, otherwise rate
# limiting and audit logs record the proxy's address for every user.
TRUST_PROXY=true

# Rate limiting (in-memory; no Redis required).
#
# THROTTLE_LIMIT counts per signed-in account, so one busy scanner cannot
# lock out the rest of a warehouse sharing its connection. Anonymous requests
# fall back to the address, which is what THROTTLE_LOGIN_LIMIT relies on.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1200
THROTTLE_LOGIN_LIMIT=10

# --- Seed ------------------------------------------------------------------
# Used only by `npm run db:seed`. Set these before seeding a real deployment.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

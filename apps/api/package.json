{
  "name": "@phone-erp/api",
  "version": "1.0.0",
  "private": true,
  "description": "Phone ERP REST API (NestJS + Prisma + PostgreSQL)",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:imeis": "ts-node --transpile-only prisma/print-imeis.ts",
    "db:reset": "prisma migrate reset --force",
    "db:fresh-start": "ts-node --transpile-only prisma/scripts/fresh-start.ts",
    "db:reset-stock-and-warehouses": "ts-node --transpile-only prisma/scripts/reset-stock-and-warehouses.ts",
    "simulate": "node scripts/simulate.mjs"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "8.1.0",
    "@nestjs/throttler": "6.3.0",
    "@phone-erp/shared-types": "1.0.0",
    "@prisma/client": "5.22.0",
    "argon2": "0.41.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "compression": "1.7.5",
    "cookie-parser": "1.4.7",
    "helmet": "8.0.0",
    "nodemailer": "10.0.10",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "prisma": "5.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.15",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/multer": "2.2.0",
    "@types/node": "22.10.2",
    "@types/nodemailer": "8.0.2",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.6.3"
  }
}

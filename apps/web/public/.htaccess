# Single-page application routing: any path that is not a real file serves the
# app shell, so refreshing /transfers/123 works instead of returning 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api
  # Never answer a missing asset with the app shell: after a deploy an old tab
  # asks for chunk filenames that no longer exist, and returning HTML for them
  # turns a clean 404 into an unreadable MIME-type error.
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Asset filenames contain a content hash, so they can be cached forever.
  <FilesMatch "\.(js|css|woff2|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The shell and the service worker must always be revalidated, or a deploy
  # would never reach anyone who already has the app installed.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
